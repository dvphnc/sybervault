      ],
      "quote": "In secure coding, the door is locked. Path Traversal doesn’t break the lock; it simply walks around the wall.",
      "review": [
        {
          "q": "What is path traversal?",
          "a": "Using ../ to access files outside the intended application directory."
        },
        {
          "q": "What is double encoding?",
          "a": "Encoding ../ as %252e%252e%252f to bypass single-pass URL decoders."
        },
        {
          "q": "What is null byte injection?",
          "a": "%00 terminates strings early in legacy C-style APIs."
        },
        {
          "q": "Best prevention?",
          "a": "Allowlists of valid filenames + realpath() verification within an allowed directory."
        }
